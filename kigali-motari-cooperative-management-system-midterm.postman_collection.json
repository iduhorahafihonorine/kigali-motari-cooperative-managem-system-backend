              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Zones returned', function () { pm.response.to.have.status(200); });",
                  "const zones = pm.response.json();",
                  "zones.forEach(z => {",
                  "  if (z.name === 'Nyabugogo') pm.collectionVariables.set('zoneNyabugogoId', z.id);",
                  "  if (z.name === 'Kimironko') pm.collectionVariables.set('zoneKimironkoId', z.id);",
                  "  if (z.name === 'Remera') pm.collectionVariables.set('zoneRemeraId', z.id);",
                  "  if (z.name === 'Nyamirambo') pm.collectionVariables.set('zoneNyamiramboId', z.id);",
